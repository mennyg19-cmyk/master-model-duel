# Generated by `npm run gen:env-example` from lib/env-spec.ts. Do not edit by hand.

# Postgres connection string (embedded Postgres on port 4106 locally)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:4106/app"

# HMAC secret for session cookies (min 32 chars; use crypto-random bytes)
AUTH_SECRET="generate-a-long-random-string"

# Dev-only login without Clerk (true/false). Hard-disabled on Vercel production deploys regardless of this value.
DEV_AUTH_BYPASS="false"

# Vercel Blob token for media uploads (R-180). Optional: without it, uploads use the local .uploads/ driver.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxx"
