# Generated by `npm run env:example` from src/lib/env-spec.ts. Do not edit by hand.
# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string. Local dev uses the embedded cluster on port 4104.
# Secret: rotate immediately if it ever leaves this machine.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:4104/tomchei?schema=public

# Public base URL of this deployment. Used for absolute links in emails and print routes.
APP_URL=http://127.0.0.1:3104

# clerk = hosted Clerk identity. local = passwordless signed-cookie identity for offline dev and CI; it is rejected unless APP_URL points at this machine, and it refuses to open a session in a production runtime.
AUTH_PROVIDER=local

# HMAC key for local session and impersonation cookies. At least 32 characters of real randomness: generate with `openssl rand -base64 48`. The placeholder below is rejected on purpose, so a deployment cannot boot with a secret an attacker can read in this repository.
# Secret: rotate immediately if it ever leaves this machine.
AUTH_SESSION_SECRET=change-me-to-a-32-character-random-string

# true only when a proxy you control rewrites x-forwarded-for. While false, audit rows record no client IP rather than one the caller can forge.
TRUST_PROXY_HEADERS=false

# blob = Vercel Blob, the deployment target for catalog photos. local = write them under public/uploads for offline development and CI; it is rejected unless APP_URL points at this machine, because a hosted filesystem is read-only and per-instance.
MEDIA_STORAGE=local

# Vercel Blob read-write token. Required only when MEDIA_STORAGE=blob.
# Secret: rotate immediately if it ever leaves this machine.
BLOB_READ_WRITE_TOKEN=

# Clerk publishable key. Required only when AUTH_PROVIDER=clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key. Required only when AUTH_PROVIDER=clerk.
# Secret: rotate immediately if it ever leaves this machine.
CLERK_SECRET_KEY=

# stripe = hosted Stripe Checkout, the deployment target. local = a loopback stand-in that hosts the payment page itself and signs its own callbacks with the same webhook secret, so offline development and CI run the real signature, idempotency and refund code. It is rejected unless APP_URL points at this machine, because it takes no money.
PAYMENT_PROVIDER=local

# Stripe secret key. Required only when PAYMENT_PROVIDER=stripe.
# Secret: rotate immediately if it ever leaves this machine.
STRIPE_SECRET_KEY=

# Signing secret for the /api/webhooks/stripe endpoint. Required in both modes: it is what makes a webhook authentic, and the loopback provider signs with it too so the verification path is never skipped in development.
# Secret: rotate immediately if it ever leaves this machine.
STRIPE_WEBHOOK_SECRET=
