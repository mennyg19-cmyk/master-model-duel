{
  "name": "tomchei-shabbos-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3104",
    "build": "next build",
    "start": "next start --port 3104",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "env:example": "tsx scripts/env-example.ts",
    "env:check": "node --import tsx --conditions=react-server --env-file=.env scripts/env-check.ts",
    "db:start": "tsx scripts/db-server.ts",
    "db:wait": "tsx scripts/db-wait.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:guard": "tsx scripts/migration-guard.ts",
    "db:fresh": "tsx scripts/db-fresh.ts",
    "seed": "node --import tsx --conditions=react-server --env-file=.env prisma/seed.ts",
    "test:db": "tsx scripts/test-db.ts",
    "test": "npm run test:db && node --import tsx --conditions=react-server --env-file=.env.test --test-concurrency=1 --test tests/core.test.ts tests/env-spec.test.ts tests/permissions.test.ts tests/bootstrap.test.ts tests/concurrency.test.ts tests/grouping.test.ts tests/draft-reference.test.ts tests/order-state-machine.test.ts tests/order-lifecycle.test.ts tests/order-numbers.test.ts tests/inventory.test.ts tests/scheduled-jobs.test.ts tests/catalog-browse.test.ts tests/catalog-admin.test.ts tests/media.test.ts tests/newsletter.test.ts tests/cart-builder.test.ts tests/address-book.test.ts tests/checkout.test.ts tests/payments.test.ts tests/admin-ops.test.ts tests/fulfillment.test.ts tests/shipping.test.ts tests/routes.test.ts",
    "newsletter:link": "node --import tsx --conditions=react-server --env-file=.env scripts/newsletter-link.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:p2": "tsx scripts/smoke-p2.ts",
    "smoke:p3": "tsx scripts/smoke-p3.ts",
    "smoke:p4": "tsx scripts/smoke-p4.ts",
    "smoke:p5": "node --import tsx --conditions=react-server --env-file=.env scripts/smoke-p5.ts",
    "smoke:p6": "node --import tsx --conditions=react-server --env-file=.env scripts/smoke-p6.ts",
    "smoke:p7": "node --import tsx --conditions=react-server --env-file=.env scripts/smoke-p7.ts",
    "smoke:p8": "node --import tsx --conditions=react-server --env-file=.env scripts/smoke-p8.ts",
    "smoke:p9": "node --import tsx --conditions=react-server --env-file=.env scripts/smoke-p9.ts",
    "fixtures:scale": "node --import tsx --conditions=react-server --env-file=.env scripts/fixtures-scale.ts",
    "ci": "npm run lint && npm run typecheck && npm run db:guard && npm test"
  },
  "dependencies": {
    "@clerk/nextjs": "7.6.1",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "2.6.1",
    "clsx": "2.1.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.2",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
