enum MediaStorage {
  VERCEL_BLOB
  LOCAL
}

/// An uploaded image (R-067, R-180). The bytes live in Vercel Blob in a hosted
/// deployment and on disk for local development; this row is the same either
/// way, so a product's photo does not care which store it came from.
///
/// Rows are never edited in place: replacing a photo uploads a new asset, which
/// keeps the URL stable for anything already pointing at the old one.
model MediaAsset {
  id       String       @id @default(uuid())
  storage  MediaStorage
  /// Path inside the store, unique so two uploads cannot claim the same object.
  pathname String       @unique
  url      String

  originalFilename String
  contentType      String
  sizeBytes        Int
  /// Required by the upload form: an image with no alternative text is unusable
  /// to a screen reader and there is no later screen that would ask for it.
  altText          String

  uploadedByStaffUserId String?
  createdAt             DateTime @default(now())

  uploadedBy StaffUser? @relation(fields: [uploadedByStaffUserId], references: [id], onDelete: SetNull)
  products   Product[]

  @@index([createdAt])
}
