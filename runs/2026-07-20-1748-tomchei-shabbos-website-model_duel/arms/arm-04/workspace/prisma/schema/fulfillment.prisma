enum FulfillmentKind {
  SHIPPING
  DELIVERY
  PICKUP
}

enum PackageStage {
  NEW
  PRINTED
  PACKED
  SENT
  PICKED_UP
}

/// How a method turns packages into money (UR-009). Bulk delivery drops a load at
/// one address, so the drive is billed once however many boxes are on it;
/// per-package delivery and shipping are billed per box; pickup costs nothing.
enum FeeBasis {
  NONE
  PER_PACKAGE
  PER_DESTINATION
}

/// Fulfillment methods are rows, not an enum (R-154). The org adds "volunteer
/// delivery — Lakewood" for one season without a deploy, and the grouping key
/// keeps working because it stores the method id.
model FulfillmentMethod {
  id    String          @id @default(uuid())
  code  String          @unique
  label String
  kind  FulfillmentKind

  /// Base charge the order snapshots, applied the number of times `feeBasis`
  /// says. Shipping ignores it while the placeholder rate rules are in force
  /// (R-032); live carrier quotes replace those in P8.
  baseFeeCents Int @default(0)

  feeBasis FeeBasis @default(PER_PACKAGE)

  requiresAddress        Boolean @default(true)
  requiresPickupLocation Boolean @default(false)
  isActive               Boolean @default(true)
  sortOrder              Int     @default(0)

  orderLines OrderLine[]
  packages   Package[]
}

model PickupLocation {
  id           String  @id @default(uuid())
  name         String  @unique
  line1        String
  line2        String?
  city         String
  state        String
  postalCode   String
  instructions String?
  isActive     Boolean @default(true)

  orderLines OrderLine[]
  packages   Package[]
}

/// A physical box (UR-001). Lines that share a recipient, address, fulfillment
/// method and greeting travel together; anything else gets its own package,
/// because the card and the label in the box would otherwise be wrong.
///
/// The stages are optional on purpose: an org that only prints never advances
/// past PRINTED, and printing must never imply shipped (G-001, G-004).
model Package {
  id      String @id @default(uuid())
  orderId String

  /// Hash of the four grouping inputs. Unique per order so the finalize
  /// transaction cannot create the same package twice under a retry.
  groupingKey String

  recipientName       String
  fulfillmentMethodId String
  pickupLocationId    String?

  addressLine1      String?
  addressLine2      String?
  addressCity       String?
  addressState      String?
  addressPostalCode String?
  addressCountry    String?

  greetingMessage String?

  /// Volunteer delivery runs over several days in Purim week, and the recipient
  /// picks one of the days the manager opened (UR-009, G-015).
  deliveryDay String?

  /// What this package was actually charged for its fulfillment, frozen at
  /// checkout (G-028). Staff moving a box to another method later is an
  /// operations decision, not a re-price: without this snapshot the recount
  /// would hand back money the customer already agreed to pay, or bill more.
  fulfillmentFeeCents Int @default(0)

  stage      PackageStage @default(NEW)
  printedAt  DateTime?
  packedAt   DateTime?
  sentAt     DateTime?
  pickedUpAt DateTime?

  /// What the carrier's address validator said about this destination (R-177).
  /// Kept on the package rather than the address book row: the box is what is
  /// being shipped, and the book entry may be edited afterwards.
  addressValidatedAt      DateTime?
  addressIsValid          Boolean?
  addressValidationNote   String?

  packageTypeId String?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillmentMethod FulfillmentMethod @relation(fields: [fulfillmentMethodId], references: [id])
  pickupLocation    PickupLocation?   @relation(fields: [pickupLocationId], references: [id])
  packageType       PackageType?      @relation(fields: [packageTypeId], references: [id])
  lines             OrderLine[]
  shipmentBoxes     ShipmentBox[]
  shippingQuotes    ShippingQuote[]
  printItems        PrintBatchItem[]

  @@unique([orderId, groupingKey])
  @@index([stage])
}

/// Box sizes the org stocks. Rate shopping needs real dimensions (R-157).
model PackageType {
  id             String  @id @default(uuid())
  name           String  @unique
  lengthMm       Int
  widthMm        Int
  heightMm       Int
  maxWeightGrams Int
  isActive       Boolean @default(true)

  packages      Package[]
  shipmentBoxes ShipmentBox[]
}

/// A label's life. PENDING is written *before* the carrier is called, so a
/// second person pressing Buy finds the box already claimed and no order can end
/// up paying for two labels (R-175). VOID_PENDING is the honest state for a
/// carrier that accepts a refund request and answers days later.
enum ShippingLabelStatus {
  PENDING
  PURCHASED
  FAILED
  VOID_PENDING
  VOIDED
}

/// One parcel of one package: the box that is taped shut and handed over. Bin
/// packing plans them (R-081); contents too big for the largest stocked box
/// become several, each with its own label and tracking number.
model ShipmentBox {
  id            String @id @default(uuid())
  packageId     String
  packageTypeId String?

  parcelIndex    Int     @default(0)
  weightGrams    Int
  carrier        String?
  serviceCode    String?
  serviceLabel   String?
  trackingNumber String? @unique
  labelUrl       String?

  status ShippingLabelStatus @default(PENDING)

  /// Shippo's transaction id: what a void is requested against (R-173).
  providerTransactionId String? @unique
  providerRateId        String?

  /// The margin, kept as the three numbers it is made of rather than one
  /// derived figure (UR-003, G-006). Reconciliation in P12 sums `marginCents`;
  /// the two sides are here so a disputed row can be read without a rate lookup.
  carrierCostCents   Int?
  customerPriceCents Int?
  marginCents        Int?

  /// Why the carrier refused, in the carrier's own words. Nothing from here is
  /// shown to a customer.
  failureMessage String?

  trackingStatus    String?
  trackingCheckedAt DateTime?

  purchasedAt DateTime?

  /// Set when a printed label is cancelled during a reroute (UR-004). The row
  /// stays so the carrier charge can be reconciled later.
  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package     Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageType PackageType? @relation(fields: [packageTypeId], references: [id])

  @@index([packageId])
  @@index([status])
}

/// Where the price on the checkout screen came from. A carrier outage must not
/// close the store, so the settings rate from P5 is still there to fall back on
/// — and the row says which of the two the customer was actually charged.
enum ShippingQuoteSource {
  LIVE
  FALLBACK
}

/// Carrier rates go stale, so a quote carries its own expiry and checkout must
/// re-quote rather than charge an old price (R-155).
model ShippingQuote {
  id        String  @id @default(uuid())
  orderId   String
  packageId String?

  /// The grouping key of the box this quote is for. Checkout quotes before any
  /// package row exists, so the key is what ties the quote to the package that
  /// finalize later creates.
  groupingKey String?

  source                ShippingQuoteSource @default(LIVE)
  destinationPostalCode String
  parcelCount           Int                 @default(1)
  billableWeightGrams   Int                 @default(0)

  /// What the customer is charged for this box: the highest eligible quote
  /// (UR-003). Stored rather than recomputed, because the fee frozen on the
  /// package has to be traceable to a number somebody can point at.
  customerPriceCents Int @default(0)

  requestedAt DateTime @default(now())
  expiresAt   DateTime

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  options ShippingQuoteOption[]

  @@index([orderId])
  @@index([expiresAt])
}

/// Margin capture (UR-003): the customer is charged the higher quoted rate while
/// the org ships on the cheaper carrier and keeps the spread, so the two amounts
/// are stored separately and reconciled internally.
model ShippingQuoteOption {
  id      String @id @default(uuid())
  quoteId String

  carrier      String
  serviceCode  String
  serviceLabel String

  carrierCostCents   Int
  customerPriceCents Int
  transitDays        Int?

  /// The carrier the label is bought on: the cheapest of the eligible options.
  isSelected Boolean @default(false)

  /// False when the carrier answered but the org cannot ship it — no account
  /// for that carrier, or it could not price every parcel of the box.
  isEligible Boolean @default(true)

  /// Shippo's rate id, which is what a label is purchased against (R-173).
  providerRateId String?

  quote ShippingQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, carrier, serviceCode])
}
