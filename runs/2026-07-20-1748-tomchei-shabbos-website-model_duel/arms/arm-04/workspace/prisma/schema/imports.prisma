/// Staged CSV import (R-063, R-143). A file is never applied as it is read:
/// every row is written here first with its own verdict, a person looks at the
/// preview, and only then does one transaction write the whole batch.
///
/// Nothing about the file survives except these rows, which are what the audit
/// trail points at when somebody asks where a customer record came from.
enum ImportKind {
  CUSTOMERS
  PRODUCTS
}

enum ImportBatchStatus {
  STAGED
  COMMITTED
  DISCARDED
}

/// `DUPLICATE` is not `INVALID`: a row that names somebody already on file is
/// usually a re-export, and the commit updates that record instead of refusing
/// the batch. An `INVALID` row is one nobody can act on, and it blocks.
enum ImportRowStatus {
  VALID
  DUPLICATE
  INVALID
}

model ImportBatch {
  id       String            @id @default(uuid())
  kind     ImportKind
  status   ImportBatchStatus @default(STAGED)
  fileName String

  /// Set for a product import: products belong to a season, and staging has to
  /// know which one before it can tell a new slug from an existing one.
  seasonId String?

  rowCount      Int @default(0)
  validCount    Int @default(0)
  duplicateCount Int @default(0)
  invalidCount  Int @default(0)

  /// Filled by the commit: what was written, so the preview counts and the
  /// result can be compared without re-reading every row.
  createdCount Int @default(0)
  updatedCount Int @default(0)

  stagedByStaffUserId String?
  stagedAt            DateTime  @default(now())
  committedAt         DateTime?

  stagedBy StaffUser?  @relation(fields: [stagedByStaffUserId], references: [id], onDelete: SetNull)
  season   Season?     @relation(fields: [seasonId], references: [id])
  rows     ImportRow[]

  @@index([status, stagedAt])
}

model ImportRow {
  id       String          @id @default(uuid())
  batchId  String
  /// 1-based line number in the uploaded file, so an error message names the
  /// row the person is looking at in their spreadsheet.
  lineNumber Int
  status   ImportRowStatus

  /// The parsed columns, kept verbatim. A commit re-validates from this rather
  /// than from anything the preview screen posts back.
  parsed Json @default("{}")

  /// Why an invalid row is invalid, or which record a duplicate matched.
  problem String?
  matchedId String?

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, lineNumber])
  @@index([batchId, status])
}
