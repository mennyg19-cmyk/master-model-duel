enum OrderStatus {
  DRAFT
  PLACED
  IN_FULFILLMENT
  COMPLETED
  CANCELLED
  DISCARDED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERPAID
}

enum PaymentMethod {
  STRIPE
  CASH
  CHECK
  COMP
}

enum PaymentState {
  POSTED
  VOIDED
}

model Order {
  id       String @id @default(uuid())
  seasonId String

  /// Null while a guest is still building the cart. Guest checkout collects the
  /// details that create the customer (P5), so until then the token below is the
  /// only thing that owns the draft.
  customerId String?

  /// SHA-256 of the access token in the guest's cookie (R-023). Hashed because a
  /// stolen database row must not be a working key, and unique so two guests
  /// cannot land on the same draft. `draftReference` is quotable over the phone
  /// and therefore guessable, so it never grants access on its own.
  guestTokenHash String? @unique

  /// Set while a cart is being built at the counter (R-059). The customer is
  /// already named on `customerId`, so this is not who the order is for — it is
  /// which till it is open on, which keeps a POS cart out of that customer's own
  /// web session and gives each staff member one open till at a time.
  posStaffUserId String?

  status OrderStatus @default(DRAFT)

  /// Handed out once, at finalize. Drafts quote `draftReference` instead, so a
  /// customer who abandons a cart never burns a season order number (R-151).
  orderNumber Int?

  /// Human-quotable id for a cart in progress, in the wire format staff read
  /// over the phone (R-047).
  draftReference String @unique

  /// Order-level card message. A line may override it per recipient (UR-013).
  defaultGreeting String?

  subtotalCents       Int @default(0)
  fulfillmentFeeCents Int @default(0)
  totalCents          Int @default(0)

  /// Derived from posted payments and cached here so order lists do not sum the
  /// payment table for every row (R-152). `recomputeOrderPaymentStatus` is the
  /// only writer.
  paymentStatus   PaymentStatus @default(UNPAID)
  amountPaidCents Int           @default(0)

  placedAt    DateTime?
  discardedAt DateTime?

  /// Optimistic-concurrency stamp, same contract as StaffUser: a mutation must
  /// match the version it read.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season         Season                @relation(fields: [seasonId], references: [id])
  /// Restrict rather than the default SetNull for an optional relation: an order
  /// with no owner at all would break the CHECK constraint that every order is
  /// owned by an account or a guest token, and past orders are the customer's
  /// receipt history.
  customer       Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  posStaffUser   StaffUser?            @relation("PosTill", fields: [posStaffUserId], references: [id], onDelete: SetNull)
  lines          OrderLine[]
  packages       Package[]
  reservations   Reservation[]
  payments       Payment[]
  paymentIntents StripePaymentIntent[]
  shippingQuotes ShippingQuote[]

  @@unique([seasonId, orderNumber])
  @@index([seasonId, status])
  @@index([customerId, createdAt])
  /// The order desk pages placed orders newest-first inside one season, and the
  /// dashboard counts them by status. Both read this index instead of the table.
  @@index([seasonId, status, placedAt])
  @@index([posStaffUserId, status])
}

/// One catalog item going to one recipient. The destination lives on the line
/// because a single order routinely ships to a dozen different people (UR-006);
/// packages are then derived from these lines, not the other way round.
model OrderLine {
  id       String @id @default(uuid())
  orderId  String
  quantity Int

  productId String

  /// Snapshots. The catalog can be re-priced or renamed after an order is
  /// placed, and what the customer agreed to must not move with it (R-150).
  productNameSnapshot String
  unitPriceCents      Int
  optionsSnapshot     Json @default("[]")
  lineTotalCents      Int

  /// Both null while the cart is still being built: the customer picks items
  /// first and assigns each one to a recipient afterwards (UR-006, G-018). A
  /// CHECK constraint keeps them in step — a line with a recipient and no method,
  /// or the reverse, is a half-assigned line no screen could show — and finalize
  /// refuses an order that still has an unassigned line.
  recipientName       String?
  fulfillmentMethodId String?
  pickupLocationId    String?

  /// Copied from the address book rather than referenced, for the same snapshot
  /// reason. `customerAddressId` records where it came from.
  customerAddressId String?
  addressLine1      String?
  addressLine2      String?
  addressCity       String?
  addressState      String?
  addressPostalCode String?
  addressCountry    String?

  greetingMessage String?

  /// One of the delivery days the manager opened for Purim week, chosen per
  /// destination at checkout and copied onto the package it lands in (UR-009).
  deliveryDay String?

  /// Filled at finalize by the grouping engine.
  packageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id])
  fulfillmentMethod FulfillmentMethod? @relation(fields: [fulfillmentMethodId], references: [id], onDelete: Restrict)
  pickupLocation    PickupLocation?    @relation(fields: [pickupLocationId], references: [id])
  customerAddress   CustomerAddress?   @relation(fields: [customerAddressId], references: [id])
  package           Package?           @relation(fields: [packageId], references: [id], onDelete: SetNull)
  addOns            OrderLineAddOn[]

  @@index([orderId])
  @@index([packageId])
}

model OrderLineAddOn {
  id          String @id @default(uuid())
  orderLineId String
  addOnId     String
  quantity    Int

  addOnNameSnapshot String
  unitPriceCents    Int
  lineTotalCents    Int

  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  addOn     AddOn     @relation(fields: [addOnId], references: [id])

  @@unique([orderLineId, addOnId])
}

/// Cash and checks are entered by staff at the POS, Stripe rows arrive from the
/// webhook, and comps are manager gifts. Nothing is ever deleted: a mistake is
/// voided so the paper trail survives (R-160).
model Payment {
  id          String        @id @default(uuid())
  orderId     String
  method      PaymentMethod
  state       PaymentState  @default(POSTED)
  amountCents Int

  /// Stripe intent id, check number, or POS receipt id.
  reference  String?
  receivedAt DateTime  @default(now())
  voidedAt   DateTime?
  voidReason String?

  recordedByStaffUserId String?

  createdAt DateTime @default(now())

  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recorded StaffUser?    @relation(fields: [recordedByStaffUserId], references: [id], onDelete: SetNull)
  refunds  PaymentRefund[]

  @@index([orderId, state])
}

/// Money going back out (R-168). A refund is its own row rather than a negative
/// payment so the ledger still answers "what did they pay us" and "what did we
/// return" separately, and so a partial refund cannot be mistaken for a void.
model PaymentRefund {
  id          String @id @default(uuid())
  paymentId   String
  amountCents Int

  /// Stripe refund id, or the POS receipt for an offline return.
  reference String? @unique
  reason    String

  recordedByStaffUserId String?

  createdAt DateTime @default(now())

  payment  Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  recorded StaffUser? @relation(fields: [recordedByStaffUserId], references: [id], onDelete: SetNull)

  @@index([paymentId])
}

/// One hosted Checkout attempt (resolution 8b). The row is a mirror of what the
/// gateway reports — never a source of truth for whether money arrived. The
/// matching `Payment` row is what the cached order status counts.
///
/// The session id exists from the moment the customer is sent to the hosted
/// page; the payment intent id only arrives with the event that says the card
/// was charged, which is why it is nullable.
model StripePaymentIntent {
  id              String  @id @default(uuid())
  orderId         String
  stripeSessionId String  @unique
  stripeIntentId  String? @unique
  status          String
  amountCents     Int
  currency        String  @default("usd")

  lastEventAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Every webhook the gateway sends, recorded before it is acted on (R-125,
/// R-167). The unique event id is the idempotency key: a replay — Stripe retries
/// for days — loses the insert race and is answered 200 without charging,
/// refunding or committing stock a second time.
model StripeWebhookEvent {
  id      String @id @default(uuid())
  eventId String @unique
  type    String

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  outcome     String?

  @@index([receivedAt])
}
