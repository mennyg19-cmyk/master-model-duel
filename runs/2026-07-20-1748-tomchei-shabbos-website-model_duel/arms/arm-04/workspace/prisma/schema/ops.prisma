enum CronRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Every scheduled job writes a row here (R-163). Without it, a sweeper that
/// quietly stopped running looks exactly like a sweeper with nothing to do.
model CronRunLog {
  id       String        @id @default(uuid())
  jobName  String
  status   CronRunStatus @default(RUNNING)
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  itemsProcessed Int      @default(0)
  detail         Json     @default("{}")

  @@index([jobName, startedAt])
}
