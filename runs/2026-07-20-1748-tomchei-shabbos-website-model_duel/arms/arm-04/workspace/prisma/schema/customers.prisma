enum GeocodeOutcome {
  FOUND
  NOT_FOUND
  FAILED
}

/// Customers hold their own identity link. No role column exists here by design
/// (UR-012): a customer can never inherit staff access.
model Customer {
  id              String   @id @default(uuid())
  externalAuthId  String?  @unique
  email           String   @unique
  normalizedEmail String   @unique
  fullName        String
  phone           String?
  /// E.164 form of `phone`. Unique so "(555) 010-0000" and "5550100000" cannot
  /// become two customers during a POS entry or a legacy import (R-144).
  normalizedPhone String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  addresses CustomerAddress[]
  orders    Order[]

  @@index([normalizedEmail])
}

/// One address book per customer, shared by the website and the POS (UR-014).
model CustomerAddress {
  id            String  @id @default(uuid())
  customerId    String
  label         String?
  recipientName String
  line1         String
  line2         String?
  city          String
  state         String
  postalCode    String
  country       String  @default("US")
  phone         String?

  /// Stable form of the street address. It dedupes "12 Main St." against
  /// "12 main street" and is the key into the geocode cache.
  addressKey String

  latitude   Float?
  longitude  Float?
  geocodedAt DateTime?

  /// What this recipient's card said last time (UR-013, G-020). Checkout offers
  /// it as the default the next season so a donor who writes the same line to
  /// the same aunt every year types it once.
  lastGreeting String?

  /// Set by the cleanup pass (UR-014) when the entry cannot be delivered to as
  /// written. It stays usable — an address nobody can fix is still the only
  /// thing the office knows about that recipient — but the customer screen says
  /// so, and the cleanup queue lists it.
  needsReview Boolean @default(false)
  reviewNote  String?

  /// Addresses are archived, never deleted: past orders point at them.
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]

  @@unique([customerId, addressKey])
  @@index([customerId, isArchived])
}

/// Geocoding is billed per lookup, so results are cached (R-162). A miss is kept
/// for a much shorter time than a hit: a failed address is usually a typo that
/// someone fixes within the hour, while a found address stays put for months.
model GeocodeCache {
  addressKey String         @id
  outcome    GeocodeOutcome
  latitude   Float?
  longitude  Float?
  provider   String
  expiresAt  DateTime
  createdAt  DateTime       @default(now())

  @@index([expiresAt])
}
