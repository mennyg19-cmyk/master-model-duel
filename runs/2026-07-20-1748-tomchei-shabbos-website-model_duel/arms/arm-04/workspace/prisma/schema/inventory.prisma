/// One inventory table for both products and add-ons (R-158). A row points at
/// exactly one of them; the XOR is enforced by a CHECK constraint in the
/// migration, because a row that counts two things at once is unfixable later
/// (R-139).
///
/// `reserved` is the counter the CHECK constraint guards; `Reservation` records
/// which order holds each slice of it. A second CHECK keeps `reserved` between
/// zero and `onHand`, so even a bug in the engine cannot oversell the last unit.
model InventoryItem {
  id        String  @id @default(uuid())
  productId String? @unique
  addOnId   String? @unique

  onHand   Int @default(0)
  reserved Int @default(0)

  updatedAt DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  addOn   AddOn?   @relation(fields: [addOnId], references: [id], onDelete: Cascade)
}

enum ReservationStatus {
  HELD
  RELEASED
}

/// What one order actually took out of stock, written inside the finalize
/// transaction.
///
/// Release reads these rows rather than recomputing demand from the order's
/// current lines. The moment P5 allows a post-place edit, the lines stop
/// describing what was held, and a release derived from them would hand back a
/// quantity that was never taken — against a counter shared by every order,
/// where the CHECK constraint cannot tell the difference.
model Reservation {
  id      String @id @default(uuid())
  orderId String

  /// Exactly one of these is set, same XOR as `InventoryItem` and enforced by a
  /// CHECK constraint in the migration.
  productId String?
  addOnId   String?

  quantity Int
  status   ReservationStatus @default(HELD)

  createdAt  DateTime  @default(now())
  releasedAt DateTime?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  addOn   AddOn?   @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@unique([orderId, addOnId])
}

/// Ingredient tracking ships as schema only. Managers turn it on when the team
/// is ready, so nothing here has a UI at launch (UR-016, G-009).
model Ingredient {
  id             String  @id @default(uuid())
  name           String  @unique
  unit           String
  onHandQuantity Decimal @default(0) @db.Decimal(12, 3)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billOfMaterialLines BillOfMaterialLine[]
  consumptions        AssemblyBatchConsumption[]
}

model BillOfMaterialLine {
  id              String  @id @default(uuid())
  productId       String
  ingredientId    String
  quantityPerUnit Decimal @db.Decimal(12, 3)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
}

/// A production run: supplies go in, finished packages come out (G-010).
model AssemblyBatch {
  id               String    @id @default(uuid())
  productId        String
  quantityProduced Int
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  staffUserId      String?
  notes            String?

  product      Product                    @relation(fields: [productId], references: [id])
  staffUser    StaffUser?                 @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  consumptions AssemblyBatchConsumption[]

  @@index([productId, startedAt])
}

model AssemblyBatchConsumption {
  id              String  @id @default(uuid())
  assemblyBatchId String
  ingredientId    String
  quantityUsed    Decimal @db.Decimal(12, 3)

  assemblyBatch AssemblyBatch @relation(fields: [assemblyBatchId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])

  @@unique([assemblyBatchId, ingredientId])
}
