/// The five datasets the office takes out of the system (R-092). Named rather
/// than free text so the audit history, the download route and the export centre
/// cannot drift apart on what "the deliveries file" means.
enum ExportDataset {
  DELIVERIES
  YEAR_END
  YEAR_METRICS
  ITEM_SALES
  LAPSED_CUSTOMERS
}

/// Who took what out of the building, and how much of it (R-092).
///
/// A CSV of every donor's address leaves the app and stops being the app's
/// problem, so the row that says it happened is the only control left. The file
/// itself is never kept: it is re-derivable from the season, and storing copies
/// of the export is storing the same personal data twice.
///
/// Written when the download starts, not when it finishes: a browser that gave
/// up after the first page still took a copy of part of the file. `rowCount` is
/// what the file was going to be until `completedAt` is set, and what actually
/// went out afterwards.
model ExportLog {
  id       String        @id @default(uuid())
  dataset  ExportDataset
  seasonId String?

  rowCount  Int
  byteCount Int

  staffUserId String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  season Season?    @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  staff  StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([dataset, createdAt])
}

/// What the gateway and this database disagree about (R-093).
enum ReconciliationFlagKind {
  /// The gateway says a session was paid and no `Payment` row was ever written.
  /// Money arrived and the order does not know it.
  ORPHANED_INTENT
  /// A payment was recorded against an intent for a different amount than the
  /// order costs — a partial capture, or an order edited after it was paid.
  AMOUNT_MISMATCH
  /// A `Payment` row quotes a Stripe reference that has no intent row here, so
  /// nothing on this side can be checked against the gateway.
  MISSING_INTENT
}

enum ReconciliationFlagStatus {
  OPEN
  RESOLVED
}

/// One sweep of the payment ledger against the gateway's records (R-093).
model PaymentReconciliationRun {
  id String @id @default(uuid())

  /// "manual" when somebody pressed the button, "cron" when the schedule ran it.
  source String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  checkedCount Int @default(0)
  flaggedCount Int @default(0)
  /// Findings this run saw for the first time. A rerun over unchanged data
  /// reports zero, which is what makes "no duplicate adjustments" observable.
  newFlagCount Int @default(0)

  ranByStaffUserId String?

  ranBy StaffUser? @relation(fields: [ranByStaffUserId], references: [id], onDelete: SetNull)

  @@index([startedAt])
}

/// One disagreement, however many sweeps have seen it.
///
/// `fingerprint` is the finding's identity — the kind plus the row it is about —
/// and it is unique, so the second sweep updates the row the first one wrote
/// instead of filing the same problem again. Reconciliation must be safe to run
/// every night without turning one unmatched charge into thirty tickets.
model PaymentReconciliationFlag {
  id          String                   @id @default(uuid())
  fingerprint String                   @unique
  kind        ReconciliationFlagKind
  status      ReconciliationFlagStatus @default(OPEN)

  orderId         String?
  stripeSessionId String?
  stripeIntentId  String?

  /// What the gateway says, and what this database expected. Both in cents.
  amountCents   Int @default(0)
  expectedCents Int @default(0)

  note String

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  lastSeenRunId String

  resolvedAt DateTime?

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, lastSeenAt])
}
